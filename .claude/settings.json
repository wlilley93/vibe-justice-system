{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{}' | \"$CLAUDE_PROJECT_DIR/target/debug/vjs\" hook --event session_start 2>/dev/null || true",
            "statusMessage": "VJS session reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.vjs/hooks/claude-pre-write.sh\"",
            "timeout": 15,
            "statusMessage": "VJS permit gate"
          }
        ]
      }
    ]
  }
}
