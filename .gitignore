# Rust (the workspace ships binaries, so Cargo.lock is committed)
/target/
**/*.rs.bk

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Logs
*.log

# VJS
.vjs/cache/
.vjs/private/

# vjs invoke --install-hooks entrypoints (local activation, regenerated per clone)
.vjs/hooks/pre-commit
.vjs/hooks/pre-push

# vjs invoke agent-runtime adapters (thin, regenerated per clone by --install-hooks)
.vjs/hooks/adapters/

# host kernel binary exported from the Docker image (REG-FRONT-DOOR-DELIVERY-001);
# the wall's binary, regenerated per host by scripts/vjs-host-setup.sh
bin/

# stray build artifacts
*.rlib

# The realm ministry tree holds nested project repos with their own git
# history (each a separate jurisdiction); the canon does not track them.
Executive/

# stray symlink recreated by headless-render ln footgun; never track it
/assets/assets
._*
