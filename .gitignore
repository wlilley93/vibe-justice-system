# Rust (the workspace ships binaries, so Cargo.lock is committed)
/target/
**/*.rs.bk

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Logs
*.log

# VJS
.vjs/cache/
.vjs/private/

# vjs invoke --install-hooks entrypoints (local activation, regenerated per clone)
.vjs/hooks/pre-commit
.vjs/hooks/pre-push

# vjs invoke agent-runtime adapters (thin, regenerated per clone by --install-hooks)
.vjs/hooks/adapters/

# host kernel binary exported from the Docker image (REG-FRONT-DOOR-DELIVERY-001);
# the wall's binary, regenerated per host by scripts/vjs-host-setup.sh
bin/

# stray build artifacts
*.rlib

# The realm ministry tree holds nested project repos with their own git
# history (each a separate jurisdiction); the canon does not track them.
Executive/

# stray symlink recreated by headless-render ln footgun; never track it
/assets/assets
._*

# The estate's own case history is INSTANCE STATE, not product.
# `vjs invoke` generates .vjs/ per jurisdiction; a subscriber gets their own.
# All load-bearing law was transferred into lawpack/v2/ on 2026-08-06 (orders,
# opinions, warrants), verified by the fresh-install proof: a tree with no
# .vjs/ case history runs invoke -> validate -> route -> gazette clean.
# The machinery below stays tracked because the gates need it.
.vjs/submissions/
.vjs/court/
.vjs/orders/
.vjs/logs/
.vjs/permits/
.vjs/invocation/
