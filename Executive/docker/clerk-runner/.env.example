# GitHub PAT with repo + workflow scope, used to register the self-hosted runner.
# Generate a classic token at https://github.com/settings/tokens (repo + workflow scopes),
# or reuse the gh CLI token: GH_RUNNER_PAT=$(gh auth token)
GH_RUNNER_PAT=ghp_...

# --- The clerk's LLM (any Anthropic-compatible endpoint) ---
# Option A - real Anthropic:
#   ANTHROPIC_API_KEY=sk-ant-...
#   (leave ANTHROPIC_BASE_URL and CLERK_MODEL at their defaults)
#
# Option B - GLM on z.ai's Anthropic-compatible endpoint (no Anthropic account needed):
#   ANTHROPIC_API_KEY=<your GLM coding-plan key>       # from /etc/onyx/global.env (ZAI_API_KEY)
#   ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
#   CLERK_MODEL=glm-4.6
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLERK_MODEL=claude-sonnet-4-6
